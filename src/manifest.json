{
  "manifest_version": 3,
  "name": "Auto WebMCP",
  "short_name": "Auto WebMCP",
  "version": "0.11.0",
  "description": "Turn forms, standalone inputs, widgets, and supported searches into structured tools for compatible browser agents.",
  "minimum_chrome_version": "149",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Auto WebMCP status",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["webmcp-runtime.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["control-utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
